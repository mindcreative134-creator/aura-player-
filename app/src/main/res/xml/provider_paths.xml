<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- App internal cache directory (e.g. crash logs, mediainfo text exports, temporary subtitle files) -->
    <cache-path
        name="cache_files"
        path="." />

    <!-- App internal files directory -->
    <files-path
        name="files_path"
        path="." />

    <!-- App-specific external cache directory (e.g. downloaded APK updates) -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- App-specific external files directory (strictly scoped to Android/data/com.cmstudio.auraplayer/files) -->
    <external-files-path
        name="external_files_storage"
        path="." />
</paths>